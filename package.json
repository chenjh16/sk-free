{
  "name": "sk-free-api-broadcast",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static GitHub Pages deployment for the Sk-free API broadcast page.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port \"${PORT:-3000}\" --strictPort",
    "start": "vite --host 0.0.0.0 --port \"${PORT:-3000}\" --strictPort",
    "build": "vite build && node scripts/copy-static.mjs",
    "preview": "vite preview --host 0.0.0.0 --port \"${PORT:-3000}\""
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "vite": "^8.2.2"
  }
}
